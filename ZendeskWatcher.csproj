<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1809+ TFM is required for toast notifications. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZendeskWatcher</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>ZendeskWatcher</AssemblyName>
    <Version>1.3.3</Version>
    <Authors>Claude + Daniel Dahlin @ Optimizely</Authors>
    <Company>Optimizely</Company>
    <Product>Zendesk Watcher</Product>
    <Description>Windows tray app that notifies about new unassigned Zendesk tickets and changes on your own tickets.</Description>
    <!-- The WebView2 package also ships a WPF control we don't use; its WindowsBase reference conflict is harmless. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Only English framework resources: keeps the installer smaller. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>


</Project>
