<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1809+ TFM is required for toast notifications. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZendeskWatcher</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>ZendeskWatcher</AssemblyName>
    <Version>1.4.1</Version>
    <Authors>Claude &amp; Daniel Dahlin @ Optimizely</Authors>
    <Company>Optimizely</Company>
    <Product>Zendesk Watcher</Product>
    <Description>Windows tray app that notifies about new unassigned Zendesk tickets and changes on your own tickets.</Description>
    <!-- The WebView2 package also ships a WPF control we don't use; its WindowsBase reference conflict is harmless. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Only English framework resources: keeps the installer smaller. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in tests/, the shared code in Core/ (its own project, referenced below). -->
    <Compile Remove="tests/**;Core/**" />
    <None Remove="tests/**;Core/**" />
    <EmbeddedResource Remove="tests/**;Core/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core/ZendeskWatcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZendeskWatcher.Tests" />
    <!-- The day it was built: a release is built when it's published, so this is the release date. -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>


</Project>
