<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Mac app: a menu bar icon, macOS notifications and the Zendesk sign-in in a WKWebView, on top of the shared
    Core library (the checks and rules are the same as on Windows). Native AppKit (.NET for macOS), because it has the
    web view the Okta sign-in needs. Builds only on a Mac with Xcode (`dotnet workload install macos`); GitHub builds
    it in .github/workflows/mac.yml.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZendeskWatcher.Mac</RootNamespace>
    <AssemblyName>ZendeskWatcher</AssemblyName>
    <ApplicationTitle>Zendesk Watcher</ApplicationTitle>
    <ApplicationId>io.github.optidada.zendeskwatcher</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <!-- One app for Apple silicon and Intel Macs. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <!-- Settings and Zendesk models are read with reflection (System.Text.Json): don't trim. -->
    <LinkMode>None</LinkMode>
    <!-- A slightly different Xcode than the workload was made for usually works fine. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- No Apple developer account yet: ad-hoc signing (Gatekeeper: "Open Anyway"). -->
    <EnableCodeSigning>true</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/ZendeskWatcher.Core.csproj" />
  </ItemGroup>

</Project>
